{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 10 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "adixon/ca.civicrm.logviewer",
                "version": "2.1.0",
                "type": "civicrm-extension",
                "dist": {
                    "url": "https://github.com/adixon/ca.civicrm.logviewer/archive/2.1.0.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "civicrm/finsburypark",
                "version": "0.22",
                "type": "civicrm-extension",
                "dist": {
                    "url": "https://lab.civicrm.org/extensions/finsburypark/-/archive/0.22/finsburypark-0.22.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "civicrm/cdntaxreceipts",
                "version": "1.9.1",
                "type": "civicrm-extension",
                "dist": {
                    "url": "https://lab.civicrm.org/extensions/cdntaxreceipts/-/archive/1.9.1/cdntaxreceipts-1.9.1.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "civicrm/sparkpost",
                "version": "1.7",
                "type": "civicrm-extension",
                "dist": {
                    "url": "https://lab.civicrm.org/extensions/sparkpost/-/archive/1.7/sparkpost-1.7.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "civicrm/sending_domain",
                "version": "1.0.2",
                "type": "civicrm-extension",
                "dist": {
                    "url": "https://lab.civicrm.org/extensions/sending_domain/-/archive/1.0.2/sending-1.0.2.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "fuzionnz/transactional",
                "version": "1.0.7",
                "type": "civicrm-extension",
                "dist": {
                    "url": "https://github.com/fuzionnz/nz.co.fuzion.transactional/archive/v1.0.7.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "veda-consulting-company/uk.co.vedaconsulting.mosaico",
                "version": "3.5",
                "type": "civicrm-extension",
                "dist": {
                    "url": "https://download.civicrm.org/extension/uk.co.vedaconsulting.mosaico/3.5.1709296836/uk.co.vedaconsulting.mosaico-3.5.1709296836.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "adixon/ca.civicrm.logviewer": "^2.1",
        "civicrm/cdntaxreceipts": "^1.9",
        "civicrm/civicrm-asset-plugin": "~1.1",
        "civicrm/civicrm-core": "^5.75.1",
        "civicrm/civicrm-drupal-8": "^5.75.1",
        "civicrm/civicrm-packages": "^5.75.1",
        "civicrm/finsburypark": "^0.22.0",
        "civicrm/sending_domain": "^1.0",
        "civicrm/sparkpost": "^1.7",
        "composer/installers": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/bootstrap_barrio": "^5.5",
        "drupal/civicrm_entity": "^4.0@alpha",
        "drupal/core-composer-scaffold": "^10.1",
        "drupal/core-project-message": "^10.1",
        "drupal/core-recommended": "^10.1",
        "drupal/ctools": "^4.0",
        "drupal/diff": "^1.1",
        "drupal/drupal-extension": "^5.0@RC",
        "drupal/environment_indicator": "^4.0",
        "drupal/flood_control": "^2.3",
        "drupal/pathauto": "^1.12",
        "drupal/redirect": "^1.9",
        "drupal/reroute_email": "^2.0",
        "drupal/role_delegation": "^1.2",
        "drupal/seckit": "^2.0",
        "drupal/smtp": "^1.2",
        "drupal/tfa": "^1.3",
        "drupal/token": "^1.13",
        "drupal/views_bulk_operations": "^4.2",
        "drush/drush": "^12.4",
        "fuzionnz/transactional": "^1.0",
        "veda-consulting-company/uk.co.vedaconsulting.mosaico": "^3.5"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "civicrm/civicrm-asset-plugin": true,
            "civicrm/composer-downloads-plugin": true,
            "civicrm/composer-compile-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "httpdocs/"
            }
        },
        "installer-paths": {
            "httpdocs/core": [
                "type:drupal-core"
            ],
            "httpdocs/libraries/{$name}": [
                "type:drupal-library"
            ],
            "httpdocs/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "httpdocs/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "httpdocs/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "httpdocs/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "httpdocs/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "httpdocs/civicrm_custom/extensions/contrib/{$name}": [
                "type:civicrm-extension"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "enable-patching": "true",
        "civicrm-asset": {
            "path": "httpdocs/libraries/civicrm",
            "url": "/libraries/civicrm"
        },
        "compile-whitelist": [
            "civicrm/civicrm-core",
            "civicrm/composer-compile-lib"
        ]
    },
    "require-dev": {
        "drupal/core-dev": "^10"
    }
}
